PORT=5000

# Database Configuration - Choose ONE:
# Option 1: Supabase PostgreSQL (Recommended for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_db_password

# Option 2: Local PostgreSQL
# SQL_HOST=127.0.0.1
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=
# SQL_DATABASE=premium_ecommerce

CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=replace_with_a_long_access_secret_key_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_refresh_secret_key_min_32_chars

# Email Configuration (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary Configuration (Optional)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# Supabase Additional Keys
SUPABASE_ANON_KEY=your_anon_key

# Razorpay Configuration (Optional)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Shiprocket Configuration (Optional)
SHIPROCKET_EMAIL=your_email@example.com
SHIPROCKET_PASSWORD=your_password
